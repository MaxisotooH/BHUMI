# BHUMI · servidor central. Copia este archivo como .env y completa los valores.
# .env NO se sube al repositorio (está en .gitignore).

# Dominio público con el que se entra a BHUMI. Caddy saca el certificado HTTPS solo.
# El DNS del dominio debe apuntar a la IP del servidor antes de levantar Caddy.
DOMINIO=bhumi.tuempresa.cl

# ---------- Google Maps Platform: dos claves ----------
# Clave del SERVIDOR (rutas y geocodificación). Nadie la ve desde el navegador.
#   Restricción de aplicación: Direcciones IP -> la IP pública del servidor.
#   Restricción de API: Geocoding API y Routes API.
GOOGLE_SERVER_KEY=

# Clave del NAVEGADOR (solo el mapa en pantalla).
#   Restricción de aplicación: Sitios web -> https://bhumi.tuempresa.cl/*
#   Restricción de API: Maps JavaScript API.
GOOGLE_BROWSER_KEY=

# ---------- Respaldo continuo (opcional, perfil "respaldo") ----------
# Cualquier almacenamiento compatible con S3. Ejemplo con Cloudflare R2:
#   LITESTREAM_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ---------- Solo para correr sin Docker (npm start) ----------
# HOST=0.0.0.0          # 127.0.0.1 = solo este equipo (valor por defecto)
# PORT=3000
# DB_FILE=data/bhumi.db
# TRUST_PROXY=1         # si hay un proxy (Caddy, nginx) delante
